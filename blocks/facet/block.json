{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "gateway/facet",
	"title": "Facet",
	"category": "widgets",
	"icon": "filter",
	"description": "An interactive filter control for one of a Data Table block's configured facets.",
	"keywords": [ "facet", "filter", "search", "datatable" ],
	"version": "0.1.0",
	"textdomain": "gateway",
	"parent": [ "gateway/datatable" ],
	"usesContext": [
		"gateway/datatable/postType",
		"gateway/datatable/columns",
		"gateway/datatable/facets"
	],
	"attributes": {
		"facetKey": {
			"type": "string",
			"default": ""
		},
		"uiType": {
			"type": "string",
			"default": "input"
		},
		"compare": {
			"type": "string",
			"default": "contains"
		}
	},
	"supports": {
		"html": false
	},
	"editorScript": "file:./build/index.js",
	"style": "file:./build/style-view.css",
	"viewScript": "file:./build/view.js",
	"render": "file:./render.php"
}
