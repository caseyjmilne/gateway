{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "gateway/card-field-number",
	"title": "Field: Number",
	"category": "widgets",
	"icon": "editor-ol",
	"description": "Displays one Number field's value from the current record, with Currency/Percent/decimal formatting. Only meaningful inside a Collection-sourced Data Cards card template, a Related Items loop, a Data Display detail template, or a Single Record template.",
	"keywords": [ "field", "number", "currency", "percent", "format", "model", "collection", "data cards" ],
	"version": "0.1.0",
	"textdomain": "gateway",
	"ancestor": [ "gateway/data-cards-body", "gateway/data-display", "gateway/single-record" ],
	"usesContext": [
		"gateway/data-cards/sourceType",
		"gateway/data-cards/collection",
		"record"
	],
	"attributes": {
		"fieldKey": {
			"type": "string",
			"default": ""
		},
		"numberFormat": {
			"type": "object",
			"default": {
				"style": "plain",
				"decimals": 2,
				"thousandsSeparator": true,
				"currencySymbol": "$",
				"currencyPosition": "before"
			}
		}
	},
	"supports": {
		"html": false,
		"typography": {
			"fontSize": true
		}
	},
	"editorScript": "file:./build/index.js",
	"render": "file:./render.php"
}
