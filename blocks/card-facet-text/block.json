{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "gateway/card-facet-text",
	"title": "Facet: Text",
	"category": "widgets",
	"icon": "search",
	"description": "A text input that narrows a Data Cards grid to records whose chosen field contains the typed text. Works for any text-renderable field, not just the ones offered as a regular Facet.",
	"keywords": [ "facet", "filter", "search", "data cards", "text", "contains" ],
	"version": "0.1.0",
	"textdomain": "gateway",
	"ancestor": [ "gateway/data-cards" ],
	"usesContext": [
		"gateway/data-cards/sourceType",
		"gateway/data-cards/postType",
		"gateway/data-cards/collection"
	],
	"attributes": {
		"fieldKey": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"typography": {
			"fontSize": true
		}
	},
	"editorScript": "file:./build/index.js",
	"style": "file:./build/style-view.css",
	"viewScript": "file:./build/view.js",
	"render": "file:./render.php"
}
