{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "gateway/data-cards",
	"title": "Data Cards",
	"category": "widgets",
	"icon": "grid-view",
	"description": "A paginated, searchable grid of posts for any registered post type -- or of a Gateway Collection's records -- laid out as a repeated, user-designed card template.",
	"keywords": [ "cards", "grid", "posts", "list", "query" ],
	"version": "0.1.0",
	"textdomain": "gateway",
	"attributes": {
		"sourceType": {
			"type": "string",
			"default": "postType"
		},
		"postType": {
			"type": "string",
			"default": "post"
		},
		"collection": {
			"type": "string",
			"default": ""
		},
		"limit": {
			"type": "number",
			"default": 0
		},
		"pageSize": {
			"type": "number",
			"default": 12
		},
		"facets": {
			"type": "array",
			"default": [],
			"items": {
				"type": "object"
			}
		}
	},
	"providesContext": {
		"gateway/data-cards/sourceType": "sourceType",
		"gateway/data-cards/postType": "postType",
		"gateway/data-cards/collection": "collection",
		"gateway/data-cards/limit": "limit",
		"gateway/data-cards/pageSize": "pageSize",
		"gateway/data-cards/facets": "facets"
	},
	"supports": {
		"html": false,
		"align": [ "wide", "full" ],
		"spacing": {
			"margin": true,
			"padding": true
		}
	},
	"editorScript": "file:./build/index.js",
	"style": "file:./build/style-view.css",
	"render": "file:./render.php"
}
