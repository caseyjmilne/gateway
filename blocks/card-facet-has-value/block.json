{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "gateway/card-facet-has-value",
	"title": "Facet: Has Value",
	"category": "widgets",
	"icon": "yes-alt",
	"description": "A checkbox that narrows a Data Cards grid to records where the chosen field actually has a value set (0/false count; null/blank don't). Works for any field, not just the ones offered as a regular Facet.",
	"keywords": [ "facet", "filter", "search", "data cards", "has value", "empty", "null" ],
	"version": "0.1.0",
	"textdomain": "gateway",
	"ancestor": [ "gateway/data-cards" ],
	"usesContext": [
		"gateway/data-cards/sourceType",
		"gateway/data-cards/postType",
		"gateway/data-cards/collection"
	],
	"attributes": {
		"fieldKey": {
			"type": "string",
			"default": ""
		},
		"displayAsCheckbox": {
			"type": "boolean",
			"default": false
		},
		"title": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"typography": {
			"fontSize": true
		}
	},
	"editorScript": "file:./build/index.js",
	"style": "file:./build/style-view.css",
	"viewScript": "file:./build/view.js",
	"render": "file:./render.php"
}
