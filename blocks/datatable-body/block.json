{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "gateway/datatable-body",
	"title": "Data Table Body",
	"category": "widgets",
	"icon": "editor-table",
	"description": "The Data Table's grid of results (headings and rows) -- a genuine sibling of the Header and Footer blocks, so its position in the editor always matches the front end.",
	"keywords": [ "body", "table", "grid", "datatable" ],
	"version": "0.1.0",
	"textdomain": "gateway",
	"parent": [ "gateway/datatable" ],
	"usesContext": [
		"gateway/datatable/sourceType",
		"gateway/datatable/postType",
		"gateway/datatable/collection",
		"gateway/datatable/limit",
		"gateway/datatable/pageSize",
		"gateway/datatable/columns",
		"gateway/datatable/facets"
	],
	"attributes": {
		"sourceType": {
			"type": "string",
			"default": "postType"
		},
		"postType": {
			"type": "string",
			"default": "post"
		},
		"collection": {
			"type": "string",
			"default": ""
		},
		"limit": {
			"type": "number",
			"default": 0
		},
		"pageSize": {
			"type": "number",
			"default": 10
		},
		"columns": {
			"type": "array",
			"default": [
				{ "key": "ID", "sortable": true },
				{ "key": "post_title", "sortable": true }
			],
			"items": {
				"type": "object"
			}
		},
		"facets": {
			"type": "array",
			"default": [],
			"items": {
				"type": "object"
			}
		}
	},
	"supports": {
		"html": false
	},
	"editorScript": "file:./build/index.js",
	"render": "file:./render.php"
}
