{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "gateway/data-cards-footer",
	"title": "Data Cards Footer",
	"category": "widgets",
	"icon": "align-bottom",
	"description": "Holds a Data Cards block's pagination and results controls, always rendered below its grid.",
	"keywords": [ "footer", "pagination", "results", "data cards" ],
	"version": "0.1.0",
	"textdomain": "gateway",
	"parent": [ "gateway/data-cards" ],
	"supports": {
		"html": false,
		"layout": {
			"allowSwitching": false,
			"allowVerticalAlignment": false,
			"default": {
				"type": "flex",
				"justifyContent": "space-between",
				"flexWrap": "nowrap"
			}
		}
	},
	"editorScript": "file:./build/index.js",
	"style": "file:./build/style-view.css",
	"render": "file:./render.php"
}
